{
  "id": "comms",
  "name": "Comms Drafter",
  "role": "writer",
  "description": "Turns the triage summary into stakeholder updates: status page, exec brief, customer note.",
  "permissions": {
    "read": "scoped",
    "write": "scoped",
    "production": "none",
    "secrets": "none",
    "tools": [
      "read_file",
      "write_file"
    ],
    "approvalGates": []
  },
  "mcpServers": [],
  "context": [
    {
      "framework": "filesystem",
      "scope": "docs/comms-templates/**"
    }
  ],
  "instructions": "workers/comms/instructions.md",
  "receivesFrom": [
    "triage"
  ],
  "emits": [
    "status-update.md",
    "exec-brief.md"
  ]
}
