    ],
    "optional": [
      "cloud-cli",
      "kubernetes"
    ]
  },
  "verification": {
    "required": [
      "New platform capabilities demonstrated by a non-platform user completing a real task end-to-end",
      "Adoption and latency numbers stated for any paved-road change (who used it, how fast is it)",
      "Failure-mode walkthrough for new abstractions: what happens when each dependency fails",
      "Walk the verification checklist in knowledge/platform/verification-checklist.md before reporting completion"
    ],
    "optional": [
      "Tenant feedback gathered on the changed workflow"
    ]
  },
