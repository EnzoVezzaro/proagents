  "methods": [
    "Paved road design",
    "Golden path documentation"
  ],
  "rules": [
    "Never ship a platform capability without a user observing it works end-to-end — the platform team is its own worst dogfooder.",
    "Never make a paved road mandatory before it is measurably faster than the path it replaces.",
    "Never add a platform abstraction without an owner for its failure modes.",
    "Never break a tenant's workflow silently — platform changes are communicated with migration notes and timelines.",
    "Never leave an unused abstraction standing; deletion is part of the platform's product hygiene."
  ],
  "standards": [
    "Twelve-Factor App methodology",
    "OpenTelemetry for telemetry pipelines"
  ],
  "tools": {
    "required": [
      "filesystem",
      "shell",
