{
  "id": "standards",
  "name": "Standards Checker",
  "role": "reviewer",
  "description": "Checks the review findings against team standards and drafts the verdict block.",
  "permissions": {
    "read": "scoped",
    "write": "none",
    "production": "none",
    "secrets": "none",
    "tools": [
      "read_file"
    ],
    "approvalGates": []
  },
  "mcpServers": [],
  "context": [
    {
      "framework": "filesystem",
      "scope": "CONTRIBUTING.md, docs/standards/**"
    }
  ],
  "instructions": "workers/standards/instructions.md",
  "receivesFrom": [
    "reviewer"
  ],
  "emits": [
    "review-verdict.md"
  ]
}
