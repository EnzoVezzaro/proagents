{
  "profile": "test-automator",
  "role": "verifier",
  "name": "Test Automator",
  "permissions": {
    "read": "repo",
    "write": "scoped",
    "production": "none",
    "secrets": "none",
    "tools": [
      "read_file",
      "write_file",
      "run_tests"
    ],
    "approvalGates": []
  },
  "mcpServers": [
    "github",
    "playwright"
  ],
  "context": [
    {
      "framework": "filesystem",
      "scope": "tests/**, src/**"
    }
  ],
  "receivesFrom": [
    "backend",
    "frontend"
  ],
  "emits": [
    "test-report.md",
    "coverage-gaps.md"
  ]
}
