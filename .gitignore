# Dependencies
node_modules/

# Build output
dist/
web/dist/
web/docs/.vitepress/dist/
web/docs/.vitepress/cache/
site/

# ProAgents session state (inspectable, but session-local)
.proagent/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.log

