{
  "name": "proagent",
  "version": "0.6.0",
  "description": "ProAgents — professional profiles for existing coding agents. Equip Claude Code, Codex, OpenCode and friends with professional expertise, methods, rules and verification. Also builds new specialized agent systems from incomplete ideas through progressive questioning.",
  "type": "module",
  "license": "MIT",
  "author": "ProAgents contributors",
  "homepage": "https://github.com/EnzoVezzaro/proagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnzoVezzaro/proagents.git"
  },
  "bugs": {
    "url": "https://github.com/EnzoVezzaro/proagents/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "multi-agent",
    "agent-builder",
    "agent-skills",
    "professional-profiles",
    "profile",
    "equip",
    "security-engineer",
    "skill",
    "skills",
    "cli",
    "ai",
    "context-engineering",
    "orchestration",
    "mcp",
    "claude",
    "codex",
    "cursor",
    "opencode"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proagent": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context/types.d.ts",
      "default": "./dist/context/types.js"
    }
  },
  "files": [
    "dist",
    "profiles",
    ".agents/skills/proagent",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run build --silent && vitest run",
    "test:watch": "vitest",
    "cli": "node ./dist/cli/index.js",
    "app:dev": "vite web",
    "app:build": "vite build web",
    "app:typecheck": "tsc -p web/tsconfig.json --noEmit",
    "docs:dev": "vitepress dev web/docs --port 4173",
    "docs:build": "vitepress build web/docs",
    "docs:preview": "vitepress preview web/docs --port 4173",
    "site:build": "npm run app:build && npm run docs:build && node scripts/assemble-site.mjs",
    "gh:token": "node scripts/github-device-token.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.0"
  },
  "optionalDependencies": {
    "acc-code-context": "^0.6.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "vite": "^5.4.11",
    "vitepress": "^1.6.0",
    "vitest": "^3.2.3"
  }
}
