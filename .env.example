# ProAgents — environment template
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored — secrets never leave your machine. `.env.example` is
# the committed template. Precedence: real environment variables > .env.local
# > .env > ~/.proagent/.env (user-global fallback).
#
# NOTE: ProAgents is fully open source — there are no payment secrets.
# Donations run through GitHub Sponsors / Ko-fi / a hosted Stripe Payment Link
# (see .github/FUNDING.yml).
# Any Stripe-related variables you may have used before are obsolete.

# ── Registry catalog (Git-as-database) ──────────────────────────────────────
# Repository hosting the registry catalog (registry/ in that repo).
# Reads are anonymous; writes need GITHUB_TOKEN with contents:write.
PROAGENT_REGISTRY_REPO=EnzoVezzaro/proagents
# (Pre-rename alias PROAGENT_MARKET_REPO is still honored.)

# ── GitHub ───────────────────────────────────────────────────────────────────
# Client ID of the "proagents" GitHub App (public — safe to expose).
# Used by the CLI (none needed) and the SPA's OAuth device flow (VITE_ below).
GITHUB_APP_CLIENT_ID=Iv23liXnwihcnEIdrvJl
# Personal access token with contents:write — required for:
#   proagent crew publish <file.json>
# The SPA instead signs in with GitHub device flow (no token stored here).
#
# Easiest setup — one command runs the OAuth device flow and writes this line
# for you (authorize the code it prints at github.com/login/device):
#   npm run gh:token
# The script also stores the refresh token (below) so later runs refresh
# silently. GitHub App user tokens expire (8h by default); to make them
# long-lived, uncheck "Expire user authorization tokens" in the proagents App
# settings, or just re-run `npm run gh:token` when the CLI reports 401/403.
GITHUB_TOKEN=
# GitHub App user-token expiry (epoch seconds, written by `npm run gh:token`).
GITHUB_TOKEN_EXPIRES_AT=0
# Silent re-auth when the access token expires (≈6-month lifetime).
GITHUB_REFRESH_TOKEN=
# Refresh-token expiry (epoch seconds).
GITHUB_REFRESH_EXPIRES_AT=0

# ── Vite (web SPA, web/) — ONLY VITE_* vars reach the deployed bundle ────────
# Rule: a variable named VITE_* is PUBLIC. Everything else stays server/local.
VITE_GITHUB_APP_CLIENT_ID=Iv23liXnwihcnEIdrvJl
VITE_REGISTRY_REPO=EnzoVezzaro/proagents
# GitHub Pages has no server: github.com/login/* sends no CORS headers, so
# production sign-in relays those two endpoints through a Cloudflare Worker.
# Deploy once: cd workers && npx wrangler deploy github-oauth-proxy.mjs --name proagents-oauth --compatibility-date 2026-01-01
VITE_OAUTH_PROXY_URL=
# Overrides the docs route prefix for the app's Docs links. Unset → the site
# base itself (/), since the app and docs are one VitePress site served from
# the domain root.
# Set it only when a fork serves docs from a different origin/prefix.
VITE_DOCS_URL=

# ── LLM providers (preview & runtime) ────────────────────────────────────────
# Deliberately NOT env vars: the Studio SPA runs entirely in the browser, #
# so provider keys are entered per-user in Settings (localStorage) and never
# touch the repository or the deployed bundle.
